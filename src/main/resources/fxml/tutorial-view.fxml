<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0"
            styleClass="tutorial-pane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vnu.uet.goldexperience.controller.TutorialController">

    <children>
        <VBox layoutX="240.0" layoutY="0.0" prefWidth="800.0" spacing="25.0"
              alignment="TOP_CENTER" styleClass="mission-panel">
            <Label text="ARKA MISSION BRIEFING" styleClass="title-label" />

            <!-- Story Content -->
            <VBox spacing="15.0" styleClass="story-content" alignment="CENTER">
                <Text styleClass="story-text" textAlignment="CENTER" wrappingWidth="750">
                    In a post-apocalyptic world, humanity has vanished, leaving only AIs behind—some corrupted, others preserving memories. An unnamed delivery robot awakens and receives a signal from E.L.A.R.A, an AI simulating the memories of Dr. Elyra. The robot must explore forgotten lands, uncover traces of humanity, and reactivate Project ARKA to restore mankind.
                </Text>
            </VBox>

            <!-- Controls Section -->
            <VBox spacing="12.0" styleClass="controls-section" alignment="CENTER">
                <Label text="CONTROLS" styleClass="section-label" />

                <VBox spacing="8.0" alignment="CENTER_LEFT" styleClass="control-list">
                    <Text styleClass="control-text">
                        → ARROW KEYS (LEFT/RIGHT) or MOUSE - Move your character
                    </Text>
                    <Text styleClass="control-text">
                        → CLICK or SPACEBAR - Shoot the ball
                    </Text>
                </VBox>
            </VBox>

            <!-- Team Credits -->
            <VBox spacing="10.0" styleClass="credits-section" alignment="CENTER">
                <Label text="DEVELOPED BY" styleClass="credits-label" />
                <Label text="Team Vip10 fifai" styleClass="team-name" />

                <VBox spacing="5.0" alignment="CENTER" styleClass="members-list">
                    <Text styleClass="member-text">Nguyen Khanh Phong</Text>
                    <Text styleClass="member-text">Bui Quang Minh</Text>
                    <Text styleClass="member-text">Tran Duy Hung</Text>
                    <Text styleClass="member-text">Nguyen Le Nam Khanh</Text>
                </VBox>
            </VBox>
            <Button fx:id="btnBack" text="◀ BACK"
                    onAction="#handleBackToSetting" styleClass="back-tutor-button" />
        </VBox>
    </children>
</AnchorPane>