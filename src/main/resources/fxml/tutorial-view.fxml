<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vnu.uet.goldexperience.controller.MenuController">
    <children>
        <!-- Character Image - Bottom Left -->
        <ImageView fx:id="characterImage" fitHeight="229.0" fitWidth="273.0"
                   layoutX="1.0" layoutY="491.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/Cyber_Faces_001.png" />
            </image>
        </ImageView>

        <!-- Mission Briefing Panel -->
        <VBox layoutX="280.0" layoutY="120.0" prefWidth="700.0" spacing="20.0"
              alignment="TOP_LEFT" style="-fx-background-color: rgba(0, 0, 0, 0.7); -fx-padding: 30px; -fx-background-radius: 10px;">

            <!-- Title -->
            <Label text="🚀 ARKANOID MISSION BRIEFING" styleClass="title-label">
                <font>
                    <Font name="W95FA" size="32.0" />
                </font>
            </Label>

            <!-- Mission Text -->
            <VBox spacing="15.0">
                <Text text="Phi hành gia chỉ huy (Log Entry #42):"
                      fill="#00FF00" style="-fx-font-weight: bold;">
                    <font>
                        <Font name="W95FA" size="20.0" />
                    </font>
                </Text>

                <Text text="Xin chào, tân binh! 👨‍🚀" fill="white">
                    <font>
                        <Font name="W95FA" size="18.0" />
                    </font>
                </Text>

                <Text text="Bạn vừa được chọn làm phi công thử nghiệm cho tàu phản xạ năng lượng Vaus. Nhiệm vụ của bạn:"
                      wrappingWidth="640.0" fill="white">
                    <font>
                        <Font name="W95FA" size="18.0" />
                    </font>
                </Text>

                <Text text="Phá hủy trường gạch lượng tử bao quanh trạm Arkanoid — và sống sót để kể lại câu chuyện này."
                      wrappingWidth="640.0" fill="#FFD700" style="-fx-font-weight: bold;">
                    <font>
                        <Font name="W95FA" size="18.0" />
                    </font>
                </Text>
            </VBox>

            <!-- Action Buttons -->
            <VBox spacing="15.0" alignment="CENTER_LEFT">
                <Button fx:id="btnBack" text="◀ BACK TO SETTING"
                        onAction="#handleBackToSetting" prefHeight="50.0" prefWidth="300.0">
                    <font>
                        <Font name="W95FA" size="18.0" />
                    </font>
                </Button>
            </VBox>
        </VBox>
    </children>
</AnchorPane>