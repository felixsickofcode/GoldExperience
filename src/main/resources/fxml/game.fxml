<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import vnu.uet.goldexperience.view.ScoreboardPanel?>

<StackPane fx:id="rootGamePane"
           style="-fx-background-color: grey;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="vnu.uet.goldexperience.controller.GameController">


    <Canvas fx:id="canvas" width="576" height="720" />

    <AnchorPane pickOnBounds="false">
        <Label fx:id="scoreLabel"
               text="SCORE: 0"
               styleClass="game-ui-label"
               AnchorPane.topAnchor="20"
               AnchorPane.leftAnchor="80" />

        <HBox fx:id="livesContainer"
              spacing="10"
              alignment="CENTER_RIGHT"
              AnchorPane.topAnchor="80"
              AnchorPane.leftAnchor="80" />

        <ScoreboardPanel fx:id="scoreboardPanel"
                         AnchorPane.topAnchor="30"
                         AnchorPane.rightAnchor="30" />
    </AnchorPane>

</StackPane>