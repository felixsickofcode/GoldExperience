<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" styleClass="menu-root" stylesheets="@../fxml/setting.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vnu.uet.goldexperience.controller.SettingController">
    <children>
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="rgba(0, 0, 0, 0.4)" height="720.0" stroke="BLACK" strokeType="INSIDE" width="1280.0" />

        <!-- Title -->
        <Text fill="#FFFFFF" layoutX="480.0" layoutY="100.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="settings-title" text="SETTINGS" textAlignment="CENTER" />

        <!-- Close Button -->
        <Button fx:id="btnQuitSetting" layoutX="35.0" layoutY="35.0" onAction="#handleBackToMenu" prefHeight="50.0" prefWidth="144.0" text="◄  BACK" />

        <!-- Settings Frame Container -->
        <AnchorPane layoutX="340.0" layoutY="160.0" prefHeight="480.0" prefWidth="600.0">
            <children>
                <!-- Outer Border Rectangle (Pink) -->
                <Rectangle arcHeight="8.0" arcWidth="8.0" fill="transparent" height="480.0" layoutX="0.0" layoutY="0.0" stroke="#ff006e" strokeWidth="4.0" styleClass="settings-frame" width="600.0" />

                <!-- Inner Border Rectangle (Cyan) -->
                <Rectangle arcHeight="6.0" arcWidth="6.0" fill="transparent" height="468.0" layoutX="6.0" layoutY="6.0" stroke="#00f5ff" strokeWidth="2.5" styleClass="settings-inner" width="588.0" />

                <!-- Content VBox -->
                <VBox alignment="CENTER" layoutX="80.0" layoutY="80.0" prefHeight="320.0" prefWidth="440.0" spacing="20.0" styleClass="vbox-container">
                    <children>
                        <!-- Music Volume Control -->
                        <VBox alignment="CENTER" prefWidth="340.0" spacing="8.0" styleClass="slider-container">
                            <children>
                                <Label styleClass="volume-title" text="MUSIC VOLUME" />
                                <Slider fx:id="musicVolumeSlider" max="100.0" min="0.0" onMouseReleased="#handleMusicVolume" showTickLabels="false" showTickMarks="false" styleClass="volume-slider" value="60.0" />
                                <Label fx:id="musicVolumeLabel" styleClass="volume-percentage" text="60%" />
                            </children>
                        </VBox>

                        <!-- Tutorial Button -->
                        <Button fx:id="btnTutorial" mnemonicParsing="false" onAction="#handleTutorial" prefHeight="90.0" prefWidth="320.0" text="TUTORIAL">
                            <font>
                                <Font size="22.0" />
                            </font>
                        </Button>

                        <!-- Exit Button -->
                        <Button fx:id="btnExit" mnemonicParsing="false" onAction="#handleExit" prefHeight="90.0" prefWidth="320.0" text="EXIT GAME">
                            <font>
                                <Font size="22.0" />
                            </font>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
