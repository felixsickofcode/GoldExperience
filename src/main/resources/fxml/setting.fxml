<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vnu.uet.goldexperience.controller.SettingController" styleClass="settings-pane">

    <children>
        <Text layoutX="480.0" layoutY="100.0" styleClass="settings-title" text="SETTINGS" textAlignment="CENTER" />

        <Button fx:id="btnQuitSetting" layoutX="35.0" layoutY="35.0" onAction="#handleBackToMenu" prefHeight="50.0" prefWidth="144.0" text="◄  BACK" />

        <AnchorPane layoutX="390.0" layoutY="190.0" prefHeight="380.0" prefWidth="500.0">
            <children>
                <AnchorPane prefHeight="380.0" prefWidth="500.0" styleClass="settings-frame" />

                <AnchorPane layoutX="6.0" layoutY="6.0" prefHeight="368.0" prefWidth="488.0" styleClass="settings-inner" />

                <VBox alignment="CENTER" layoutX="30.0" layoutY="30.0" prefHeight="320.0" prefWidth="440.0" spacing="20.0" styleClass="vbox-container">

                    <children>

                        <VBox alignment="CENTER" prefWidth="340.0" spacing="8.0" styleClass="slider-container">
                            <children>
                                <Label styleClass="volume-title" text="MUSIC VOLUME" />
                                <Slider fx:id="musicVolumeSlider" max="100.0" min="0.0" onMouseReleased="#handleMusicVolume" showTickLabels="false" showTickMarks="false" styleClass="volume-slider"/>
                                <Label fx:id="musicVolumeLabel" styleClass="volume-percentage" text="60%" />
                            </children>
                        </VBox>

                        <Button fx:id="btnTutorial" onAction="#handleTutorial" prefHeight="90.0" prefWidth="320.0" styleClass="menu-button" text="TUTORIAL">
                            <font>
                                <Font size="22.0" />
                            </font>
                        </Button>

                        <Button fx:id="btnExit" onAction="#handleExit" prefHeight="90.0" prefWidth="320.0" styleClass="menu-button" text="EXIT GAME">
                            <font>
                                <Font size="22.0" />
                            </font>
                        </Button>

                    </children>

                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>