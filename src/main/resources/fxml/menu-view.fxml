<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root, menu-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vnu.uet.goldexperience.controller.MenuController">

    <children>

        <!-- Menu Container -->
        <VBox fx:id="menuContainer" alignment="CENTER" layoutX="440.0" layoutY="300.0" prefHeight="350.0" prefWidth="400.0" spacing="20.0" styleClass="menu-container">
            <children>
                <Button fx:id="btnStoryMode" mnemonicParsing="false" onAction="#handleStoryMode" prefHeight="80.0" prefWidth="340.0" styleClass="menu-button" text="Story Mode">
                    <font>
                        <Font size="28.0" />
                    </font>
                </Button>
                <Button fx:id="btn2PlayerMode" mnemonicParsing="false" onAction="#handle2PlayerMode" prefHeight="80.0" prefWidth="340.0" styleClass="menu-button" text="2 Player Mode">
                    <font>
                        <Font size="28.0" />
                    </font>
                </Button>
                <Button fx:id="btnMoveToSetting" mnemonicParsing="false" onAction="#handleMoveToSetting" prefHeight="80.0" prefWidth="340.0" styleClass="menu-button" text="Setting">
                    <font>
                        <Font size="28.0" />
                    </font>
                </Button>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>