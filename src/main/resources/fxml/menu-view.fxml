<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root, menu-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vnu.uet.goldexperience.controller.MenuController">

    <children>
        <VBox fx:id="menuContainer" alignment="CENTER" layoutX="440.0" layoutY="300.0" prefHeight="350.0" prefWidth="400.0" spacing="20.0" styleClass="menu-container">
            <children>
                <Button fx:id="btnStoryMode" onAction="#handleStoryMode" styleClass="menu-button" text="Story Mode" />
                <Button fx:id="btn2PlayerMode" onAction="#handle2PlayerMode" styleClass="menu-button" text="2 Player Mode" />
                <Button fx:id="btnMoveToSetting" onAction="#handleMoveToSetting" styleClass="menu-button" text="Setting" />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>

    </children>
</AnchorPane>
